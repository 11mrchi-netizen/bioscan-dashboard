# Release builds are minified with R8 (see app/build.gradle.kts). The three library families named below use reflection or
# generated serializers, so their classes and the app's own @Serializable models must survive shrinking.

# kotlinx.serialization: keep generated serializers and the Companion.serializer() entry points of every model.
-keepattributes *Annotation*, InnerClasses, Signature, RuntimeVisibleAnnotations, EnclosingMethod
-dontnote kotlinx.serialization.**
-keepclassmembers class kotlinx.serialization.json.** { *** Companion; }
-keepclasseswithmembers class kotlinx.serialization.json.** { kotlinx.serialization.KSerializer serializer(...); }
-keep,includedescriptorclasses class com.bioscan.fieldterminal.**$$serializer { *; }
-keepclassmembers class com.bioscan.fieldterminal.** { *** Companion; }
-keepclasseswithmembers class com.bioscan.fieldterminal.** { kotlinx.serialization.KSerializer serializer(...); }

# supabase-kt + Ktor (engines and plugins are looked up by service loader / reflection).
-keep class io.github.jan.supabase.** { *; }
-keep class io.ktor.** { *; }
-dontwarn io.ktor.**
-dontwarn org.slf4j.**
-dontwarn java.lang.management.**
-dontwarn kotlinx.coroutines.debug.**

# Health Connect, Credential Manager, Play services, WorkManager and osmdroid ship their own consumer rules.

# WorkManager's database is generated by Room and created by reflection (androidx.startup runs it before the first frame);
# R8 stripped the generated constructor and the release build crashed on launch ("NoSuchMethodException:
# WorkDatabase_Impl.<init>"). Keep Room's database classes and WorkManager as a whole.
-keep class * extends androidx.room.RoomDatabase { <init>(); }
-keep class androidx.room.** { *; }
-keep class androidx.work.** { *; }
